package com.springSecurity.service;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.context.annotation.Bean;
import org.springframework.security.core.userdetails.UserDetailsService;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Component;

import com.springSecurity.entiry.Users;
import com.springSecurity.repository.UserDetailsRepository;

@Component
public class AdminUserInitializer {
	
	@Autowired
	private UserDetailsRepository userDetailsRepository;
	
	@Bean
	public CommandLineRunner createAdminUser(UserDetailsService userDetailsService, PasswordEncoder passwordEncoder) {
		return args ->{
			if(userDetailsRepository.findByUserName("Admin").isEmpty()) {
				
				Users admin = new Users();
				admin.setUserName("user");
				admin.setRoll("ROLE_USER");
				admin.setPassword(passwordEncoder.encode("12345"));
				userDetailsRepository.save(admin);
				System.out.println("Default Admin is Created ");
			}
		};
	}
}
